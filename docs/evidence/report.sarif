  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "parity-gate",
          "semanticVersion": "0.1.0",
          "informationUri": "https://github.com/Kattiell/parity-gate",
          "rules": [
            {
              "id": "PG1001",
              "name": "FIELD_REMOVED",
              "shortDescription": {
                "text": "A field present in the baseline is absent from the candidate."
              },
              "fullDescription": {
                "text": "Consumers that read the field get undefined or crash; if it was always present, typed clients fail to deserialise."
              },
              "help": {
                "text": "Consumers that read the field get undefined or crash; if it was always present, typed clients fail to deserialise."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1001",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1002",
              "name": "FIELD_NOW_OPTIONAL",
              "shortDescription": {
                "text": "A field that was always present is sometimes missing."
              },
              "fullDescription": {
                "text": "Clients written without a null check for it fail on the responses that omit it."
              },
              "help": {
                "text": "Clients written without a null check for it fail on the responses that omit it."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1002",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1003",
              "name": "NULLABLE_ADDED",
              "shortDescription": {
                "text": "A field can now be null where it never was."
              },
              "fullDescription": {
                "text": "Null-pointer failures in typed clients and 'null' rendered in UIs."
              },
              "help": {
                "text": "Null-pointer failures in typed clients and 'null' rendered in UIs."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1003",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1004",
              "name": "TYPE_CHANGED",
              "shortDescription": {
                "text": "A field's type was replaced by an incompatible one."
              },
              "fullDescription": {
                "text": "Parsers reject the payload or silently mis-read it (money as a string is the classic)."
              },
              "help": {
                "text": "Parsers reject the payload or silently mis-read it (money as a string is the classic)."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1004",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1005",
              "name": "TYPE_WIDENED",
              "shortDescription": {
                "text": "A field can now carry a type it did not before."
              },
              "fullDescription": {
                "text": "Safe within the numeric family; any other new type is one existing parsers never saw."
              },
              "help": {
                "text": "Safe within the numeric family; any other new type is one existing parsers never saw."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1005",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1006",
              "name": "TYPE_NARROWED",
              "shortDescription": {
                "text": "A field stopped carrying one of the types it used to."
              },
              "fullDescription": {
                "text": "Usually harmless; code paths that handled the dropped type go dead."
              },
              "help": {
                "text": "Usually harmless; code paths that handled the dropped type go dead."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1006",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1007",
              "name": "FIELD_ADDED",
              "shortDescription": {
                "text": "A field is new in the candidate."
              },
              "fullDescription": {
                "text": "Ignored by tolerant readers; strict schema validation on the client rejects it."
              },
              "help": {
                "text": "Ignored by tolerant readers; strict schema validation on the client rejects it."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1007",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG1008",
              "name": "FIELD_NOW_ALWAYS_PRESENT",
              "shortDescription": {
                "text": "An optional field is now always present."
              },
              "fullDescription": {
                "text": "Harmless for consumers."
              },
              "help": {
                "text": "Harmless for consumers."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg1008",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "family": "drift"
              }
            },
            {
              "id": "PG2001",
              "name": "VALUE",
              "shortDescription": {
                "text": "Baseline and candidate return different values for the same request."
              },
              "fullDescription": {
                "text": "Consumers see different data after the migration: prices, totals, flags."
              },
              "help": {
                "text": "Consumers see different data after the migration: prices, totals, flags."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2002",
              "name": "TYPE",
              "shortDescription": {
                "text": "A value has a different JSON type on each side."
              },
              "fullDescription": {
                "text": "The same parse failure a type drift causes, observed on one concrete value."
              },
              "help": {
                "text": "The same parse failure a type drift causes, observed on one concrete value."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2002",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2003",
              "name": "MISSING_IN_CANDIDATE",
              "shortDescription": {
                "text": "A key or collection item returned by the baseline is missing from the candidate."
              },
              "fullDescription": {
                "text": "Data disappears for consumers: a row, an attribute, a page entry."
              },
              "help": {
                "text": "Data disappears for consumers: a row, an attribute, a page entry."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2003",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2004",
              "name": "EXTRA_IN_CANDIDATE",
              "shortDescription": {
                "text": "The candidate returns a key or collection item the baseline did not."
              },
              "fullDescription": {
                "text": "Consumers see data they did not before, which may be an exposure."
              },
              "help": {
                "text": "Consumers see data they did not before, which may be an exposure."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2004",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2005",
              "name": "LENGTH",
              "shortDescription": {
                "text": "A collection has a different number of items on each side."
              },
              "fullDescription": {
                "text": "Pagination, counts and 'no results' states diverge."
              },
              "help": {
                "text": "Pagination, counts and 'no results' states diverge."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2005",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2006",
              "name": "ORDER_ONLY",
              "shortDescription": {
                "text": "The same items come back in a different order."
              },
              "fullDescription": {
                "text": "Harmless unless order is part of the contract; then assert on the sort key."
              },
              "help": {
                "text": "Harmless unless order is part of the contract; then assert on the sort key."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2006",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2007",
              "name": "ORDER",
              "shortDescription": {
                "text": "The same items come back in a different order, and order is compared."
              },
              "fullDescription": {
                "text": "Lists render in a different sequence; 'first item' logic changes."
              },
              "help": {
                "text": "Lists render in a different sequence; 'first item' logic changes."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2007",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "family": "difference"
              }
            },
            {
              "id": "PG2008",
              "name": "KEY_MATCH_UNAVAILABLE",
              "shortDescription": {
                "text": "Identity matching was requested but the key is not unique on both sides."
              },
              "fullDescription": {
                "text": "A configuration problem: differences reported under this collection may be ordering artefacts rather than regressions."
              },
              "help": {
                "text": "A configuration problem: differences reported under this collection may be ordering artefacts rather than regressions."
              },
              "helpUri": "https://github.com/Kattiell/parity-gate/blob/main/docs/rules.md#pg2008",
              "defaultConfiguration": {
                "level": "error"
